# Git ignore — HabboAirBobba

# Baseline / inject outputs (large binaries)
/HabboAir.swf
/HabboAir_bobba.swf
/HabboAir.swf.bak_*
/HabboAir.swf.backup
/HabboAir*.swf

# FFDec (optional local copy - prefer sibling traxmachine or download)
ffdec/

# Decompiled upstream dump (huge). Keep Bobba-owned helpers tracked.
cleanswf/scripts/**
!cleanswf/scripts/Logger.as
!cleanswf/scripts/com/
!cleanswf/scripts/com/sulake/
!cleanswf/scripts/com/sulake/habbo/
!cleanswf/scripts/com/sulake/habbo/messenger/
!cleanswf/scripts/com/sulake/habbo/messenger/MainView.as
!cleanswf/scripts/com/sulake/habbo/ui/
!cleanswf/scripts/com/sulake/habbo/ui/widget/
!cleanswf/scripts/com/sulake/habbo/ui/widget/chatinput/
!cleanswf/scripts/com/sulake/habbo/ui/widget/chatinput/RoomChatInputView.as
!cleanswf/scripts/com/sulake/habbo/window/
!cleanswf/scripts/com/sulake/habbo/window/utils/
!cleanswf/scripts/com/sulake/habbo/window/utils/bobba/
!cleanswf/scripts/com/sulake/habbo/window/utils/bobba/**
!cleanswf/scripts/com/sulake/habbo/window/utils/traxmachine/
!cleanswf/scripts/com/sulake/habbo/window/utils/traxmachine/**

# Deployed pack copies (source of truth is brand-pack/ + client-assets/ + sibling traxmachine-pack)
/bobba/
/traxmachine/
/local_include/

# Optional local Trax pack copy (~57MB). Prefer sibling ..\traxmachine\traxmachine-pack.
/traxmachine-pack/

# Tooling scratch
tools/inject-staging/
tools/inject-log.txt
tools/_*/
tools/_*
tools/_ffdec_extract_help/
tools/_export_check/

# ADL / package outputs
runtime/**
!runtime/.gitkeep
dist/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
*.log
.idea/
.vscode/
